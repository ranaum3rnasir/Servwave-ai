.codex/
auth.json
codex-auth.json

# Claude Code runtime locks (machine-local, never commit)
.claude/scheduled_tasks.lock
.claude/*.lock

# Project knowledge base — machine-local working files (codebase map, pipeline
# status, fix-agent state). Referenced repo-relative as `memory/` on every OS.
# Restore/sync content separately; un-ignore here if you want it synced via git.
memory/

# Obsidian vault — its own git repo, canonical copy lives as a SIBLING of this
# repo at ../Vault/ALPHA_CRM_VAULT. Ignore any in-repo copy so it never gets
# committed (and to avoid a nested/embedded git repo inside the app repo).
Vault/
# Playwright reports & test artifacts
frontend/playwright-report/
frontend/playwright-report-api/
frontend/test-results/
frontend/e2e/test-results-api/

# Spec documents & plans (reference only)

# Screenshots
frontend/e2e/Screenshots/

