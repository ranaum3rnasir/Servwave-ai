# Dependencies (match dirs AND symlinks named node_modules at any depth)
node_modules

# Build outputs
dist/
build/
storybook-static/
# `tsc -b` incremental state. Machine-local and rewritten by every build, so a committed
# copy shows up as a spurious diff in unrelated PRs (it rode into #1763 that way).
*.tsbuildinfo

# Environment files
.env
.env.local
.env.production
.env.*
# ...but the committed templates must survive the .env.* wildcard above.
# They carry placeholders only, never real values.
!.env.example
!**/.env.example
.mcp.json

