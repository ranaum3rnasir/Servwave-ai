{
  "knownAreas": [
    "*",
    ".github/**",
    "backend/**",
    "docs/**",
    "md_files/**",
    "scripts/**",
    "frontend/*",
    "frontend/e2e/**",
    "frontend/public/**",
    "frontend/scripts/**",
    "frontend/src/**"
  ],
  "triggers": [
    {
      "code": "lockfile",
      "patterns": [
        "**/package-lock.json",
        "**/npm-shrinkwrap.json",
        "**/yarn.lock",
        "**/pnpm-lock.yaml"
      ]
    },
    {
      "code": "package-manifest",
      "patterns": [
        "**/package.json",
        "**/.npmrc",
        ".nvmrc",
        ".node-version",
        ".tool-versions"
      ]
    },
    {
      "code": "tsconfig",
      "patterns": [
        "**/tsconfig*.json"
      ]
    },
    {
      "code": "test-config",
      "patterns": [
        "frontend/vitest.config.*",
        "frontend/vitest.workspace.*",
        "frontend/vite.config.*",
        "frontend/pwa-manifest.ts",
        "frontend/public-page-routing.ts",
        "frontend/public-entry-build.ts",
        "frontend/public-early-script.ts",
        "frontend/public-early.template.js",
        "frontend/vendor-chunks.ts"
      ]
    },
    {
      "code": "setup-file",
      "patterns": [
        "frontend/src/__tests__/setup.ts"
      ]
    },
    {
      "code": "workflows",
      "patterns": [
        ".github/workflows/**",
        ".github/actions/**"
      ]
    },
    {
      "code": "env-file",
      "patterns": [
        "frontend/.env*"
      ]
    }
  ],
  "alwaysRun": [
    "frontend/src/**/*guard*.test.{ts,tsx}",
    "frontend/src/__tests__/mobile-gate-*.test.ts",
    "frontend/src/__tests__/test-ci-*.test.ts",
    "frontend/src/__tests__/test-brake-*.test.ts",
    "frontend/src/__tests__/test-select-*.test.ts",
