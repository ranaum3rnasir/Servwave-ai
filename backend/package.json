    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.6.2",
    "@types/node-cron": "^3.0.11",
    "@types/pdfmake": "^0.3.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "cpx": "^1.5.0",
    "js-yaml": "4.3.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
