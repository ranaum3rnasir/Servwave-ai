    "@google/genai": "^2.23.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.75.1",
    "@supabase/supabase-js": "^2.116.0",
    "@types/multer": "^2.2.0",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "parseurl": "~1.3.3",
    "pdfmake": "^0.3.11",
    "rate-limiter-flexible": "^11.2.1",
    "resend": "^6.28.1",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
