{
  "name": "alpha-crm-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && npm run copy-pdf-assets",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "copy-pdf-assets": "cpx \"src/lib/pdf/fonts/**/*\" dist/lib/pdf/fonts",
    "start": "node dist/index.js",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "tsx src/seed.ts",
    "seed:tax-rates": "tsx src/seed-tax-rates.ts",
    "seed:orgb": "tsx src/seed-org-b.ts",
    "seed:demo-org": "SEED_DEMO_ALPHA=true tsx src/seed-demo-org.ts",
    "db:seed:org": "tsx src/seed-organization.ts",
    "test": "vitest run",
    "test:authorization": "vitest run --config vitest.authorization.config.ts",
    "test:db": "tsx scripts/ci-db/cli.ts run",
    "test:db:stop": "tsx scripts/ci-db/cli.ts stop",
    "test:watch": "vitest",
    "verify:stripe": "tsx scripts/verify-stripe.ts",
    "verify:lead-stage-clocks": "tsx scripts/verify-lead-stage-clocks.ts",
    "audit:deposit-mismatch": "tsx scripts/audit-deposit-mismatch.ts",
    "verify:attachment-bucket": "tsx scripts/verify-attachment-bucket.ts",
    "sweep:attachment-orphans": "tsx scripts/attachment-orphan-sweep.ts",
    "ctm:backfill": "tsx scripts/ctm-backfill.ts",
    "texts:fill-company-numbers": "tsx scripts/text-company-number-fill-in.ts",
    "texts:fill-other-party-numbers": "tsx scripts/text-other-party-number-fill-in.ts",
    "texts:split-conversations-by-pair": "tsx scripts/sms-conversation-pair-split.ts",
    "phone:repair-history": "tsx scripts/phone-history-repair.ts",
    "backfill:estimate-containers": "tsx scripts/estimate-container-backfill.ts",
    "ctm:reattribute": "tsx scripts/ctm-reattribute.ts",
    "automations:seed-defaults": "tsx scripts/seed-default-automations.ts",
    "copilot:smoke": "node scripts/copilot-smoke.mjs",
    "copilot:brain-smoke": "node scripts/copilot-brain-smoke.mjs",
    "copilot:codex-smoke": "tsx scripts/copilot-codex-smoke.ts",
    "copilot:live-probe": "node scripts/copilot-live-probe.mjs",
    "org:create": "tsx scripts/create-org.ts",
    "org:set-plan": "tsx scripts/set-plan.ts",
    "org:audit": "tsx scripts/audit-org.ts",
    "fixture:big-company": "tsx scripts/synthetic-big-company.ts",
    "permissions:check-preset-migration": "tsx src/scripts/check-preset-migration.ts",
    "permissions:preset-dry-run": "tsx src/scripts/preset-migration-report.ts dry-run",
    "permissions:preset-proof": "tsx src/scripts/preset-migration-report.ts proof",
    "permissions:drift": "tsx src/scripts/check-role-permission-drift.ts",
    "jobs:close-out-upgrade-dry-run": "tsx src/scripts/job-close-out-upgrade-report.ts dry-run",
    "jobs:close-out-upgrade-proof": "tsx src/scripts/job-close-out-upgrade-report.ts proof",
    "mailboxes:user-dry-run": "tsx src/scripts/user-mailbox-report.ts dry-run",
    "mailboxes:user-proof": "tsx src/scripts/user-mailbox-report.ts proof"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
